# Copier ce fichier vers .env.prod sur le VPS. Ne jamais committer .env.prod.
APP_PORT=8084
APP_BIND_HOST=127.0.0.1
APP_DOMAIN=thechoice.mlaghuibrahim.fr
NODE_ENV=production
API_PORT=3000
FRONTEND_URL=https://thechoice.mlaghuibrahim.fr
PUBLIC_WEB_URL=https://thechoice.mlaghuibrahim.fr
CORS_ORIGINS=https://thechoice.mlaghuibrahim.fr

POSTGRES_USER=thechoice_prod
POSTGRES_PASSWORD=change_me_long_random_database_password
POSTGRES_DB=thechoice
DATABASE_URL=postgresql://thechoice_prod:change_me_long_random_database_password@postgres:5432/thechoice

JWT_SECRET=change_me_with_openssl_rand_hex_48
JWT_REFRESH_SECRET=change_me_with_another_openssl_rand_hex_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30

SMTP_HOST=change_me_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change_me_smtp_user
SMTP_PASSWORD=change_me_smtp_password
MAIL_FROM="The Choice <reservation@thechoice.mlaghuibrahim.fr>"
RESTAURANT_EMAIL=contact@thechoicerestaurant.fr

# Cloudflare Turnstile — créer le widget pour APP_DOMAIN
TURNSTILE_SITE_KEY=change_me_turnstile_site_key
TURNSTILE_SECRET_KEY=change_me_turnstile_secret_key

# Rappels automatiques environ 24 h avant les réservations confirmées
REMINDERS_ENABLED=true

ADMIN_EMAIL=admin@thechoicerestaurant.fr
ADMIN_PASSWORD=change_me_strict_initial_admin_password
